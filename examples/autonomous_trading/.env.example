# Autonomous Trading Configuration Example
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to version control

# ============================================
# BROKER CREDENTIALS
# ============================================
# Get these from https://alpaca.markets/
ALPACA_API_KEY=your_api_key_here
ALPACA_API_SECRET=your_api_secret_here

# Set to true for paper trading (recommended), false for live trading
ALPACA_PAPER=true

# ============================================
# CAPITAL MANAGEMENT
# ============================================
# Starting capital (use small amount for testing)
INITIAL_CAPITAL=1000

# Maximum amount to allocate per position
MAX_POSITION_SIZE=200

# ============================================
# RISK MANAGEMENT
# ============================================
# Stop loss percentage (2 = 2%)
STOP_LOSS_PERCENT=2

# Take profit percentage (5 = 5%)
TAKE_PROFIT_PERCENT=5

# Maximum number of concurrent positions
MAX_POSITIONS=5

# Maximum daily loss limit in dollars
MAX_DAILY_LOSS=100

# Maximum trades per day
MAX_DAILY_TRADES=10

# ============================================
# TRADING SCHEDULE
# ============================================
# Execution frequency in minutes (5 = check every 5 minutes)
EXECUTION_FREQUENCY=5

# Cooldown period between trades on same symbol (in minutes)
COOLDOWN_PERIOD=60

# ============================================
# NOTIFICATION SETTINGS (Optional)
# ============================================
# Email for alerts
ALERT_EMAIL=your_email@example.com

# SMTP settings for email alerts
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Enable/disable email alerts
ENABLE_EMAIL_ALERTS=false

# ============================================
# STRATEGY PARAMETERS
# ============================================
# Timeframe for trading (1day, 1hour, 5min, etc.)
TIMEFRAME=1day

# Lookback period for indicators
INDICATOR_PERIOD=20

# Minimum volume filter (0 = disabled)
MIN_VOLUME=1000000

# ============================================
# MONITORING
# ============================================
# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Log file location
LOG_FILE=trading.log

# Performance log location
PERFORMANCE_LOG=performance.json
